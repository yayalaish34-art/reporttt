# Copy to .env.local and fill in. .env.local is gitignored.

# Where the SQLite database lives — the reports, the uploaded photographs, the
# active templates and the signatures, all of it.
#
# Leave empty locally: it defaults to ./data/reports.db, which is the project
# directory and durable by definition.
#
# ON A DEPLOYMENT THIS MUST POINT AT A MOUNTED VOLUME. The default path is inside
# the application directory, which a container rebuilds on every deploy — so
# without a volume the whole database is silently recreated empty each time. That
# shows up sideways rather than loudly: a report keeps its photo captions (they
# live in the report's own JSON) while the image files are gone, so the document
# is produced with an empty appendix and nothing reports an error.
#
# On Railway: attach a volume to the service, mount it at /data, and set
#   REPORT_DB_PATH=/data/reports.db
# /api/health reports whether this is configured — see `storage.durable`.
REPORT_DB_PATH=

# Enables the "draft with AI" buttons on the subject and opening sentence.
# Without it the app still works — the sentences are composed from the survey
# data by rule, which is the default path in any case.
OPENAI_API_KEY=

# Model used for drafting. Defaults to gpt-4o.
OPENAI_MODEL=gpt-4o

# Galit CRM database, used only by `npm run import:crm` to pull the
# customer directory. The app itself never reads it.
CRM_DATABASE_URL=

# Basic-auth password for the whole app. Set on the deployment; leave empty
# locally, where the alternative is typing it into every dev session.
APP_PASSWORD=

# Files each finished report onto the customer's card in the CRM.
# Leave empty to keep reports local — the download is unaffected either way.
CRM_API_URL=
CRM_API_TOKEN=
